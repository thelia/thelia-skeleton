{
  "name": "thelia/thelia-skeleton",
  "description": "Skeleton that contains required packages for Thelia",
  "license": "LGPL-3.0+",
  "require": {
    "thelia/core": "dev-twig",
    "thelia/flexy": "dev-twig",
    "thelia/backoffice-default-template": "dev-twig",
    "thelia/email-default-template": "dev-twig",
    "thelia/pdf-default-template": "dev-twig",
    "symfony/flex": "^2.4"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "endpoint": [
        "https://api.github.com/repos/YannLe/thelia-test-recipes/contents/index.json?ref=flex/main",
        "flex://defaults"
      ]
    },
    "installer-paths": {
      "vendor/{$vendor}/modules/{$name}": [
        "type:thelia-module"
      ],
      "template/frontOffice/{$name}": [
        "type:thelia-frontoffice-template"
      ],
      "template/backOffice/{$name}": [
        "type:thelia-backoffice-template"
      ],
      "template/email/{$name}": [
        "type:thelia-email-template"
      ],
      "template/pdf/{$name}": [
        "type:thelia-pdf-template"
      ],
      "local/": [
        "type:thelia-local"
      ]
    }
  }
}
